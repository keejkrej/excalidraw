{
  "name": "excalidraw-monorepo",
  "private": true,
  "homepage": ".",
  "workspaces": [
    "excalidraw-app",
    "packages/*"
  ],
  "scripts": {
    "build-node": "node ./scripts/build-node.js",
    "build:desktop": "bun run --cwd ./excalidraw-app tauri:build",
    "build:common": "bun run --cwd ./packages/common build:esm",
    "build:element": "bun run --cwd ./packages/element build:esm",
    "build:excalidraw": "bun run --cwd ./packages/excalidraw build:esm",
    "build:math": "bun run --cwd ./packages/math build:esm",
    "build:packages": "bun run build:common && bun run build:math && bun run build:element && bun run build:excalidraw",
    "build:version": "bun run --cwd ./excalidraw-app build:version",
    "build": "bun run --cwd ./excalidraw-app build:renderer",
    "start": "bun run --cwd ./excalidraw-app tauri:dev",
    "start:renderer": "bun run --cwd ./excalidraw-app dev:renderer",
    "start:desktop": "bun run --cwd ./excalidraw-app tauri:dev",
    "test:all": "bun run test:typecheck && bun run test:code && bun run test:other && bun run test:app --watch=false",
    "test:app": "vitest",
    "test:code": "oxlint --quiet --config ./.oxlintrc.json --ignore-path ./.oxlintignore .",
    "test:other": "oxfmt --check --config ./.oxfmtrc.json --ignore-path ./.oxfmtignore .",
    "test:typecheck": "tsc",
    "test:update": "bun run test:app --update --watch=false",
    "test": "bun run test:app",
    "test:coverage": "vitest --coverage",
    "test:coverage:watch": "vitest --coverage --watch",
    "test:ui": "bun run test --ui --coverage.enabled=true",
    "fix:code": "oxlint --quiet --fix --config ./.oxlintrc.json --ignore-path ./.oxlintignore .",
    "fix:other": "oxfmt --write --config ./.oxfmtrc.json --ignore-path ./.oxfmtignore .",
    "fix": "bun run fix:other && bun run fix:code",
    "locales-coverage": "node scripts/build-locales-coverage.js",
    "locales-coverage:description": "node scripts/locales-coverage-description.js",
    "prepare": "husky install",
    "format": "oxfmt --write --config ./.oxfmtrc.json --ignore-path ./.oxfmtignore .",
    "release": "node scripts/release.js",
    "release:test": "node scripts/release.js --tag=test",
    "release:next": "node scripts/release.js --tag=next",
    "release:latest": "node scripts/release.js --tag=latest",
    "rm:build": "rimraf --glob excalidraw-app/build excalidraw-app/dist excalidraw-app/dev-dist packages/*/dist packages/*/build",
    "rm:node_modules": "rimraf --glob node_modules excalidraw-app/node_modules packages/*/node_modules",
    "clean-install": "bun run rm:node_modules && bun install"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@types/chai": "4.3.0",
    "@types/jest": "27.4.0",
    "@types/lodash.throttle": "4.1.7",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "3.1.0",
    "@vitest/coverage-v8": "3.0.7",
    "@vitest/ui": "2.0.5",
    "chai": "4.3.6",
    "dotenv": "16.0.1",
    "husky": "7.0.4",
    "jsdom": "22.1.0",
    "lint-staged": "12.3.7",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "pepjs": "0.5.3",
    "rewire": "6.0.0",
    "rimraf": "^5.0.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vite-plugin-checker": "0.7.2",
    "vite-plugin-svgr": "4.2.0",
    "vitest": "3.0.6",
    "vitest-canvas-mock": "0.3.3"
  },
  "resolutions": {
    "strip-ansi": "6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.3.8"
}
