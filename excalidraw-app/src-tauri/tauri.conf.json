{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw",
  "version": "0.1.0",
  "identifier": "com.excalidraw.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "bun run build:renderer",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Excalidraw desktop editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw File",
        "description": "Excalidraw scene file",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
